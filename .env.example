# Copy to .env.local and fill in to enable accounts (Google sign-in).
# Both values come from the Supabase dashboard: Project Settings → API.
# They are safe to ship in the browser; the database is protected by its
# access rules, not by hiding these. Full setup: supabase/README.md.
#
# Without these the app runs in local demo mode and keeps data on this device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set only if Aura is hosted under a sub-path (e.g. /aura/). Default "/".
# VITE_BASE=/
